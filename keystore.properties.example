# Copy to keystore.properties (untracked, see .gitignore) to sign release builds.
# Without keystore.properties, assembleRelease produces an unsigned APK.
# Keep the keystore OUTSIDE the repository. Never commit real values.
storeFile=C:/path/outside/repo/jarvis-release.jks
storePassword=CHANGE_ME
keyAlias=jarvis
keyPassword=CHANGE_ME